// Place your key bindings in this file to override the defaults
[
    {
        "key": "cmd+\\",
        "command": "-workbench.action.splitEditor"
    },
    {
        "key": "cmd+\\",
        "command": "workbench.action.splitEditor"
    },
    {
        "key": "shift+cmd+r",
        "command": "workbench.view.remote"
    },
    {
        "key": "alt+cmd+v",
        "command": "-workbench.action.editorDictation.start",
        "when": "hasSpeechProvider && !editorReadonly && !speechToTextInProgress"
    },
    {
        "key": "alt+cmd+v",
        "command": "livePreview.start.externalPreview.atFile"
    },
    {
        "key": "alt+cmd+u",
        "command": "editor.action.transformToUppercase"
    },
    {
        "key": "alt+cmd+l",
        "command": "-toggleSearchEditorContextLines",
        "when": "inSearchEditor"
    },
    {
        "key": "alt+cmd+l",
        "command": "-toggleFindInSelection",
        "when": "editorFocus"
    },
    {
        "key": "alt+cmd+l",
        "command": "editor.action.transformToLowercase"
    },
    {
        "key": "shift+cmd+c",
        "command": "-workbench.action.terminal.openNativeConsole",
        "when": "!isSessionsWindow && !terminalFocus"
    },
    {
        "key": "shift+cmd+c",
        "command": "-workbench.action.browser.addElementToChat",
        "when": "browserHasUrl && chatIsEnabled && config.chat.sendElementsToChat.enabled && !browserHasError && activeEditor == 'workbench.editor.browser'"
    },
    {
        "key": "shift+cmd+g",
        "command": "workbench.view.extension.geminiChat",
        "when": "viewContainer.workbench.view.extension.geminiChat.enabled && !runningOnCloudShell"
    },
    {
        "key": "alt+cmd+g",
        "command": "-workbench.view.extension.geminiChat",
        "when": "viewContainer.workbench.view.extension.geminiChat.enabled && !runningOnCloudShell"
    },
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\r"
        },
        "when": "terminalFocus"
    }
]
